  "provider": {
    "deepseek-web": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek Web Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek quick-mode alias (local web route)"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek expert-mode alias (local web route)"
        }
      }
    }
  }
}
